# Environment Variables for Hocco Admin Panel
# Copy this file to .env and fill in your actual values

# API Configuration
REACT_NATIVE_API_URL=https://your-backend-api.vercel.app/api
REACT_NATIVE_APP_NAME=Hocco Admin Panel
REACT_NATIVE_ENV=production

# Authentication
REACT_NATIVE_ADMIN_SECRET_KEY=your-admin-secret-key-here

# Third-party Services
REACT_NATIVE_MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# App Configuration
REACT_NATIVE_VERSION=1.0.0
REACT_NATIVE_DEBUG=false